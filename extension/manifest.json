{
  "manifest_version": 3,
  "name": "Toolkit for Accelo",
  "version": "0.12.3",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "description": "Light, dark and system themes, checklist progress, Markdown descriptions and layout preferences for Accelo.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://d203gnlohy77cz.cloudfront.net/*",
    "https://d23xudf289lfof.cloudfront.net/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Toolkit for Accelo settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://digitalguppy.accelo.com/*"
      ],
      "js": [
        "vendor/theme-proxy.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://digitalguppy.accelo.com/*"
      ],
      "js": [
        "vendor/theme.js",
        "theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://digitalguppy.accelo.com/*"
      ],
      "js": [
        "core.js",
        "content.js",
        "vendor/markdown.js",
        "descriptions.js",
        "inbox.js",
        "timesheet-core.js",
        "timesheets.js",
        "retainers-core.js",
        "retainers.js"
      ],
      "css": [
        "content.css",
        "vendor/editor.css",
        "descriptions.css",
        "inbox.css",
        "timesheets.css",
        "retainers.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://digitalguppy.accelo.com/*"
      ],
      "js": [
        "timesheet-core-main.js",
        "timesheet-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://digitalguppy.accelo.com/*"
      ],
      "js": [
        "retainers-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
